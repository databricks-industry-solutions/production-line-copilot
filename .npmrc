# npm settings for reliable installs in constrained build sandboxes
# (e.g. the Databricks Apps build environment).
#
# WHY registry is pinned to public npm:
# The Databricks Apps build sandbox can only reach the public npm registry.
# If a developer's global npm config points at a private/internal mirror, a
# local `npm install` bakes that mirror's host into package-lock.json's
# `resolved` URLs; the sandbox then times out fetching from the unreachable
# mirror and the app never starts ("did not start within 10 minutes"). Pinning
# the registry here (repo-local) forces every install — local or sandbox — to
# use public npm, so the lockfile stays portable. (See also the package-lock
# normalize guard in scripts/deploy.sh.)
registry=https://registry.npmjs.org/
#
# WHY maxsockets=1000:
# npm's default socket pool is 15. When a project has more dependencies than
# that, the extra tarball fetches are queued inside npm's HTTP agent. On a
# transient network hiccup in a resource/network-constrained sandbox, those
# queued fetches can strand forever — the install hangs and the process
# eventually exits with "npm error Exit handler never called!" (see npm/cli#9386).
# Raising the socket pool above the dependency count removes that queue so
# fetches fail fast and retry instead of hanging.
maxsockets=1000

# Be resilient to transient registry blips during the (long) install.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000

# Skip audit/fund network calls at install time — faster, fewer moving parts.
fund=false
audit=false
