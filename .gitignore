.DS_Store
node_modules/
.npm-cache/
build/
.env
.env.*
# ...but keep the committed template (placeholders only, no real values).
!env.example
.databricks/
.cursor/
# Internal AI-assistant tooling config (ai-devkit / appkit) — kept locally for
# development, excluded from the public solution accelerator.
AGENTS.md
CLAUDE.md
.venv/
.pytest_cache/
.coverage
htmlcov/
__pycache__/
*.pyc
.smoke-test/
test-results/
playwright-report/
data/generated/
*.egg-info/
.vscode/
output/

# Ephemeral debugging captures (curl output, ad-hoc test logs). Created by
# operator scripts and should never be committed.
.tmp_*

# Local MLflow tracking DB created by evaluations / local eval runs. Ephemeral
# per-machine state — never commit.
mlflow.db
mlflow.db-journal
mlruns/

# Compiled JS bundles. The TypeScript sources in client/src/ and server/ are
# the source of truth; dist/ is regenerated by `npm run build`. Tracking
# the build output causes noisy diffs and stale-bundle bugs.
client/dist/
dist/server/

# Operator-specific deploy configs (real workspace identifiers, SP UUIDs,
# Lakebase hosts). The committed config/project-settings.yaml + app.yaml +
# app.dev.yaml ship as SET_ME placeholders; copy them to *.local.yaml,
# fill in your values, and deploy.sh / sync_project_settings.py /
# refresh_app_yaml_ids.py will prefer the .local.yaml siblings.
# Globbed rather than enumerated: render_app_yaml.py writes app.<env>.local.yaml
# for whatever env it is given, so listing envs by hand left app.prod.local.yaml
# — the one carrying production hosts and SP ids — as the single unignored copy.
config/project-settings.local.yaml
app.local.yaml
app.*.local.yaml

# Generated from project-settings.local.yaml (or .yaml) at deploy time.
# Never commit — it carries the resolved deployer email + per-environment
# resource IDs / hosts.
config/bundle-targets.yaml

# Internal AI-devkit phase documentation (requirements/design/planning/
# implementation/monitoring/prompts + review artifacts and roadmap). Kept
# locally for the dev workflow but not published; it contains internal
# process notes, not product/user-facing docs.
docs/ai/

# Local one-off dev/media helper scripts (not part of the shipped tooling).
scripts/patch_prodline_film.py
scripts/_dedash.py
