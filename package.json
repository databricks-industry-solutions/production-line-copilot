{
  "name": "productionline-copilot",
  "version": "0.4.2",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server/server.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "build:client": "rm -rf client/dist && tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "build:server": "rm -rf dist/server && tsc -p tsconfig.server.build.json",
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.client.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ast-grep": "appkit lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run && npm run test:smoke",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:smoke:setup": "playwright install chromium",
    "clean": "rm -rf client/dist dist build node_modules .smoke-test test-results playwright-report",
    "postinstall": "npm run typegen",
    "prebuild": "npm run sync && npm run typegen",
    "predev": "npm run sync && npm run typegen",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types",
    "setup": "appkit setup --write"
  },
  "keywords": [
    "databricks",
    "appkit",
    "solution-accelerator",
    "manufacturing",
    "productionline-copilot",
    "agent"
  ],
  "author": "Databricks, Inc.",
  "license": "Apache-2.0",
  "description": "ProdLine CoPilot: a Databricks App (AppKit + React frontend, FastAPI agent backend) delivering real-time manufacturing line monitoring and an AI assistant.",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@databricks/appkit": "^0.48.0",
    "@databricks/appkit-ui": "^0.48.0",
    "@databricks/sdk-experimental": "^0.14.2",
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.546.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "superjson": "^2.2.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@ast-grep/napi": "^0.37.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "@types/express": "^5.0.5",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.6.2",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.0.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "^7.3.5",
    "fast-uri": "^3.1.4",
    "brace-expansion": "^5.0.9",
    "uuid": "^11.1.1",
    "drizzle-orm": "^0.45.2",
    "js-yaml": "^4.3.1",
    "dompurify": "^3.4.13",
    "nanoid": "^3.3.17",
    "echarts": "$echarts",
    "@opentelemetry/propagator-jaeger": "^2.9.0",
    "minimatch": "^10.0.0"
  }
}
