# Databricks workspace (set by Databricks Apps automatically, needed for local dev)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi...

# SQL Warehouse
DATABRICKS_WAREHOUSE_ID=your-warehouse-id

# Unity Catalog
UC_CATALOG=main
UC_SCHEMA=line_manager_ai_kit

# Agent server
AGENT_PORT=8001

# MLflow
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_ID=

# AppKit (set by Databricks Apps automatically)
DATABRICKS_APP_PORT=8000
